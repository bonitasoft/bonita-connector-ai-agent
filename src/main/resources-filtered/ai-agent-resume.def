<?xml version="1.0" encoding="UTF-8"?>
<definition:ConnectorDefinition xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:definition="http://www.bonitasoft.org/ns/connector/definition/6.1">
  <id>${ai-agent-resume.def.id}</id>
  <version>${ai-agent-resume.def.version}</version>
  <icon>ai-agent.png</icon>
  <category icon="ai-agent.png" id="AI Agent"/>

  <!-- Connection inputs -->
  <input name="llmProvider" type="java.lang.String" mandatory="true"/>
  <input name="llmApiKey" type="java.lang.String" mandatory="true"/>
  <input name="llmModel" type="java.lang.String" mandatory="true"/>
  <input name="llmBaseUrl" type="java.lang.String" mandatory="false"/>
  <input name="connectTimeout" type="java.lang.Integer" mandatory="false" defaultValue="30000"/>
  <input name="readTimeout" type="java.lang.Integer" mandatory="false" defaultValue="120000"/>

  <!-- Operation inputs -->
  <input name="executionId" type="java.lang.String" mandatory="true"/>
  <input name="approvalDecision" type="java.lang.String" mandatory="true"/>
  <input name="modifiedToolParams" type="java.lang.String" mandatory="false"/>

  <!-- Outputs -->
  <output name="executionId" type="java.lang.String"/>
  <output name="status" type="java.lang.String"/>
  <output name="agentResult" type="java.lang.String"/>
  <output name="agentResultJson" type="java.lang.String"/>
  <output name="iterations" type="java.lang.Integer"/>
  <output name="tokensUsed" type="java.lang.Integer"/>
  <output name="toolCallCount" type="java.lang.Integer"/>
  <output name="pendingToolCall" type="java.lang.String"/>
  <output name="success" type="java.lang.Boolean"/>
  <output name="errorMessage" type="java.lang.String"/>

  <!-- UI Pages -->
  <page id="connectionPage">
    <widget xsi:type="definition:Select" id="llmProviderWidget" inputName="llmProvider">
      <items>openai</items>
      <items>anthropic</items>
      <items>google</items>
      <items>azure-openai</items>
      <items>custom</items>
    </widget>
    <widget xsi:type="definition:Password" id="llmApiKeyWidget" inputName="llmApiKey"/>
    <widget xsi:type="definition:Text" id="llmModelWidget" inputName="llmModel"/>
    <widget xsi:type="definition:Text" id="llmBaseUrlWidget" inputName="llmBaseUrl"/>
    <widget xsi:type="definition:Text" id="connectTimeoutWidget" inputName="connectTimeout"/>
    <widget xsi:type="definition:Text" id="readTimeoutWidget" inputName="readTimeout"/>
  </page>
  <page id="operationPage">
    <widget xsi:type="definition:Text" id="executionIdWidget" inputName="executionId"/>
    <widget xsi:type="definition:Select" id="approvalDecisionWidget" inputName="approvalDecision">
      <items>approve</items>
      <items>reject</items>
      <items>abort</items>
    </widget>
    <widget xsi:type="definition:TextArea" id="modifiedToolParamsWidget" inputName="modifiedToolParams"/>
  </page>
</definition:ConnectorDefinition>
